# --------------------------------------------------
# Hent privatforbrug
# --------------------------------------------------
privatforbrug_raw <- dst_get_data(
  table = "NKN1",
  query = list(
    TRANSAKT = "P.31 Privatforbrug",
    PRISENHED = "2020-priser, kædede værdier, (mia. kr.)",
    SÆSON = "Sæsonkorrigeret",
    TID = "*"
  ),
  lang = "da",
  parse_dst_tid = FALSE
)

# --------------------------------------------------
# Behold 1999 og frem, og sortér kvartalerne
# --------------------------------------------------
privatforbrug <- data.frame(
  Tidsinterval = privatforbrug_raw$TID,
  Privatforbrug = as.numeric(privatforbrug_raw$value)
)

privatforbrug <- privatforbrug[privatforbrug$Tidsinterval >= "1999K1", ]
privatforbrug <- privatforbrug[order(privatforbrug$Tidsinterval), ]

# --------------------------------------------------
# Beregn årlig realvækst
# --------------------------------------------------
privatforbrug$Realvaekst <- c(
  rep(NA, 4),
  (
    privatforbrug$Privatforbrug[5:nrow(privatforbrug)] /
      privatforbrug$Privatforbrug[1:(nrow(privatforbrug) - 4)] - 1
  ) * 100
)

# --------------------------------------------------
# Saml realvækst og indikatorer efter kvartal
# --------------------------------------------------
samlet <- merge(
  data.frame(Tidsinterval = forv1_kvt$TID, z),
  privatforbrug[, c("Tidsinterval", "Realvaekst")],
  by = "Tidsinterval"
)

samlet <- samlet[complete.cases(samlet), ]

# --------------------------------------------------
# Beregn R² for hver indikator
# --------------------------------------------------
r2 <- numeric(ncol(z))
coef <- numeric(ncol(z))
p_vaerdi <- numeric(ncol(z))

for(i in 1:ncol(z)) {
  model <- lm(samlet$Realvaekst ~ samlet[[i + 1]])
  r2[i] <- summary(model)$r.squared
  coef[i] <- summary(model)$coefficients[2, 1]
  p_vaerdi[i] <- summary(model)$coefficients[2, 4]
}

View(samlet)
