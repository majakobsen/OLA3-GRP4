#---------------------------------------------
# Saml spørgsmål og realvækst efter kvartal
#---------------------------------------------
multipel_data <- merge(
  forv1_kvt,
  privatforbrug[, c("Tidsinterval", "Realvaekst")],
  by.x = "TID",
  by.y = "Tidsinterval"
)

multipel_data <- multipel_data[
  multipel_data$TID >= "2000K1" &
    multipel_data$TID <= "2026K2",
]

#---------------------------------------------
# Fjern tidskolonnen
#---------------------------------------------
multipel_data$TID <- NULL

#-----------------------------------------------
# Multipel lineær regression med alle spørgsmål
#-----------------------------------------------
model_multipel <- lm(Realvaekst ~ ., data = multipel_data)

summary(model_multipel)

install.packages("pls")

library(pls)

# Vælg de fem spørgsmål og realvæksten
pca_data <- multipel_data[, c(
  "Realvaekst",
  names(multipel_data)[grepl("^F[23459] ", names(multipel_data))]
)]

pca_data <- na.omit(pca_data)

# PCA-regression som på sliden
set.seed(123)

pcr.fit <- pcr(
  Realvaekst ~ .,
  data = pca_data,
  scale = TRUE,
  validation = "CV"
)

summary(pcr.fit)

# Loadings på første komponent
loadings1 <- as.matrix(pcr.fit$loadings)[, 1]

# Kvadrerede loadings som procentandele
pca_resultater <- data.frame(
  Spoergsmaal = names(loadings1),
  Loading = loadings1,
  Vaegt_procent = 100 * loadings1^2
)

# Sortér største vægt øverst
pca_resultater <- pca_resultater[
  order(pca_resultater$Vaegt_procent, decreasing = TRUE),
]

View(pca_resultater)
